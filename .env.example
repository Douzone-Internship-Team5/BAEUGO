# 이 파일을 복사해서 .env 로 만들고 값을 채운다. (.env 는 git에 올리지 않음)

# PostgreSQL
POSTGRES_USER=baeugo
POSTGRES_PASSWORD=baeugo
POSTGRES_DB=baeugo

# 로컬에서 Docker 없이 백엔드를 실행할 때 쓰는 DB 주소
DATABASE_URL=postgresql+psycopg://baeugo:baeugo@localhost:5433/baeugo

# 로그인 토큰 서명 키 (아무 긴 문자열)
JWT_SECRET_KEY=change-me

# 프론트 주소 (CORS 허용)
CORS_ORIGINS=["http://localhost:3000"]

# 외부 AI
GEMINI_API_KEY=
# 구조화 출력이 가능한 모델 ID. 평가 모델이 비어 있으면 같은 모델에 별도 호출한다.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REVIEW_MODEL=gemini-3.1-flash-lite
WHISPER_MODEL_DIR=/data/models/whisper
WHISPER_DEVICE=cpu
WHISPER_CPU_THREADS=4
